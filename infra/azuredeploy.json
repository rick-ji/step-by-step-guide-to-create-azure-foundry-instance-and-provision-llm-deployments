{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "8893794925257972979"
    }
  },
  "parameters": {
    "foundryName": {
      "type": "string",
      "defaultValue": "[format('aif-{0}', take(uniqueString(subscription().subscriptionId, resourceGroup().id), 10))]",
      "metadata": {
        "description": "Globally unique Foundry account name."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "foundry-claude-project",
      "metadata": {
        "description": "Foundry project name."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "metadata": {
        "description": "Azure region for the Foundry account and project."
      }
    },
    "claudeModelName": {
      "type": "string",
      "defaultValue": "claude-sonnet-4-6",
      "metadata": {
        "description": "Claude model ID available in the selected region."
      }
    },
    "claudeModelVersion": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Claude model version."
      }
    },
    "claudeDeploymentName": {
      "type": "string",
      "defaultValue": "claude-sonnet-global",
      "metadata": {
        "description": "Name applications use to address this deployment."
      }
    },
    "claudeCapacity": {
      "type": "int",
      "defaultValue": 25,
      "minValue": 1,
      "metadata": {
        "description": "Global Standard capacity in thousands of tokens per minute."
      }
    },
    "claudeOrganizationName": {
      "type": "string",
      "minLength": 1,
      "metadata": {
        "description": "Legal organization name used to accept the Anthropic Marketplace offer."
      }
    },
    "claudeCountryCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 2,
      "metadata": {
        "description": "Two-letter ISO country code for the legal organization."
      }
    },
    "claudeIndustry": {
      "type": "string",
      "defaultValue": "technology",
      "allowedValues": [
        "technology",
        "finance",
        "healthcare",
        "education",
        "retail",
        "manufacturing",
        "government",
        "media",
        "other"
      ],
      "metadata": {
        "description": "Industry used to accept the Anthropic Marketplace offer."
      }
    },
    "budgetAlertEmail": {
      "type": "string",
      "minLength": 3,
      "metadata": {
        "description": "Email address that receives the monthly budget notifications."
      }
    },
    "monthlyBudgetAmount": {
      "type": "int",
      "defaultValue": 200,
      "minValue": 1,
      "metadata": {
        "description": "Monthly resource-group budget in the billing currency. Set to 200 for a USD 200 budget on USD billing accounts."
      }
    },
    "budgetStartDate": {
      "type": "string",
      "defaultValue": "[utcNow('yyyy-MM-01')]",
      "metadata": {
        "description": "First day from which the monthly budget is evaluated."
      }
    },
    "budgetEndDate": {
      "type": "string",
      "defaultValue": "[dateTimeAdd(utcNow(), 'P5Y', 'yyyy-MM-dd')]",
      "metadata": {
        "description": "Budget expiration date."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "Service": "MicrosoftFoundry-Claude",
        "Environment": "Production",
        "CostCenter": "AI-001",
        "Application": "ClaudeApplication",
        "ManagedBy": "PlatformEngineering",
        "BudgetLimitUSD": "200",
        "DataClassification": "Internal"
      },
      "metadata": {
        "description": "Governance tags applied to the Foundry account and project."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[parameters('foundryName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[parameters('foundryName')]",
        "disableLocalAuth": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('foundryName'), parameters('projectName'))]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {},
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-10-01-preview",
      "name": "[format('{0}/{1}', parameters('foundryName'), parameters('claudeDeploymentName'))]",
      "sku": {
        "name": "GlobalStandard",
        "capacity": "[parameters('claudeCapacity')]"
      },
      "properties": {
        "model": {
          "format": "Anthropic",
          "name": "[parameters('claudeModelName')]",
          "version": "[parameters('claudeModelVersion')]"
        },
        "modelProviderData": {
          "organizationName": "[parameters('claudeOrganizationName')]",
          "countryCode": "[toUpper(parameters('claudeCountryCode'))]",
          "industry": "[parameters('claudeIndustry')]"
        },
        "versionUpgradeOption": "OnceNewDefaultVersionAvailable",
        "raiPolicyName": "Microsoft.DefaultV2"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('foundryName'))]",
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('foundryName'), parameters('projectName'))]"
      ]
    },
    {
      "type": "Microsoft.Consumption/budgets",
      "apiVersion": "2023-11-01",
      "name": "budget-foundry-claude-200",
      "properties": {
        "amount": "[parameters('monthlyBudgetAmount')]",
        "category": "Cost",
        "timeGrain": "Monthly",
        "timePeriod": {
          "startDate": "[parameters('budgetStartDate')]",
          "endDate": "[parameters('budgetEndDate')]"
        },
        "notifications": {
          "Actual80Percent": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 80,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetAlertEmail')]"
            ]
          },
          "Actual100Percent": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "thresholdType": "Actual",
            "contactEmails": [
              "[parameters('budgetAlertEmail')]"
            ]
          },
          "Forecasted100Percent": {
            "enabled": true,
            "operator": "GreaterThanOrEqualTo",
            "threshold": 100,
            "thresholdType": "Forecasted",
            "contactEmails": [
              "[parameters('budgetAlertEmail')]"
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "foundryAccountName": {
      "type": "string",
      "value": "[parameters('foundryName')]"
    },
    "foundryProjectName": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "foundryProjectEndpoint": {
      "type": "string",
      "value": "[format('https://{0}.services.ai.azure.com/api/projects/{1}', parameters('foundryName'), parameters('projectName'))]"
    },
    "claudeBaseUrl": {
      "type": "string",
      "value": "[format('https://{0}.services.ai.azure.com/anthropic', parameters('foundryName'))]"
    },
    "claudeModelDeploymentName": {
      "type": "string",
      "value": "[parameters('claudeDeploymentName')]"
    },
    "monthlyBudgetName": {
      "type": "string",
      "value": "budget-foundry-claude-200"
    }
  }
}